# Publishing config for this repo only.
#
# @hackpsu packages live in Google Artifact Registry, not npmjs.org. The
# repository grants allUsers artifactregistry.reader, so *installing* needs no
# credentials and consumers omit the always-auth line below. Publishing does
# need credentials: CI authenticates with GCP_DEPLOYER_SA_KEY, then
# google-artifactregistry-auth reads this file and writes a short-lived token
# into ~/.npmrc.
@hackpsu:registry=https://us-east4-npm.pkg.dev/hackpsu-408118/npm/
//us-east4-npm.pkg.dev/hackpsu-408118/npm/:always-auth=true
