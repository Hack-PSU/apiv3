{
  "name": "@hackpsu/react-sdk",
  "version": "1.0.1",
  "description": "Auth, providers, and the typed HackPSU API client for React frontends",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hack-PSU/apiv3.git",
    "directory": "packages/react-sdk"
  },
  "publishConfig": {
    "registry": "https://us-east4-npm.pkg.dev/hackpsu-408118/npm/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "reexports": "node scripts/generate-reexports.mjs",
    "build": "node scripts/generate-reexports.mjs && tsup",
    "typecheck": "node scripts/generate-reexports.mjs && tsc --noEmit",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@hackpsu/api-client": "1.0.1",
    "firebase": "^12.0.0",
    "jwt-decode": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "posthog-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "posthog-js": "^1.300.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.0"
  }
}
