{
  "name": "@hackpsu/api-client",
  "version": "1.0.1",
  "description": "Generated, fully typed client for the HackPSU API v3. Do not hand-edit src/generated.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hack-PSU/apiv3.git",
    "directory": "packages/api-client"
  },
  "publishConfig": {
    "registry": "https://us-east4-npm.pkg.dev/hackpsu-408118/npm/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "orval --config ./orval.config.cjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "yarn build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@types/react": "^19.0.0",
    "orval": "^8.32.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
